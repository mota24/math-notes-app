rules_version = '2';

// Notes Maths — règles de sécurité Firestore.
//
// Principe : TOUT est fermé, sauf ce qui est explicitement ouvert ci-dessous.
//  - users/<uid>/… : lisible et modifiable par ce seul compte, et seulement si son adresse est vérifiée
//    (Google l'est toujours ; un compte e-mail/mot de passe doit avoir cliqué le lien de validation).
//  - shares/<id> : un cahier partagé en lecture seule. Lisible par qui connaît l'identifiant (22 caractères
//    aléatoires), listable par son seul auteur (ses propres partages), modifiable par lui seul.
// Chaque écriture doit avoir la forme exacte de ce que l'appli produit : un champ en trop, un type inattendu,
// un identifiant incohérent avec le chemin ou une taille démesurée est refusé.
//
// Déploiement : Console Firebase → Firestore Database → Règles → coller ce fichier → Publier
// (ou, avec Firebase CLI : npx firebase-tools deploy --only firestore:rules --project math-notes-pwa).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- outils

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return verified() && request.auth.uid == uid;
    }

    // Identifiants générés par l'appli (lettres, chiffres, - et _) : rien d'autre dans un chemin
    function validId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function nullOrNumber(v) {
      return v == null || v is number;
    }

    // ---------------------------------------------------------------- espace personnel

    // Index : dossiers, cahiers, tâches et suppressions, chacun rangé en JSON texte
    match /users/{uid}/state/index {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'foldersJson', 'notebooksJson', 'todosJson', 'tombstonesJson'])
        && request.resource.data.v is int
        && request.resource.data.updatedAt is number
        && request.resource.data.foldersJson is string
        && request.resource.data.notebooksJson is string
        && request.resource.data.todosJson is string
        && request.resource.data.tombstonesJson is string;
    }

    // Réglages d'apparence (couleurs, épaisseurs…), en JSON : lus par la sauvegarde hebdomadaire sur Drive
    match /users/{uid}/state/prefs {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'json'])
        && request.resource.data.v is int
        && request.resource.data.updatedAt is number
        && request.resource.data.json is string && request.resource.data.json.size() <= 20000;
    }

    // État de la sauvegarde hebdomadaire sur Google Drive : écrit par le serveur seul (SDK Admin, qui ne
    // passe pas par ces règles), lu par l'appli pour afficher la dernière sauvegarde ou un échec
    // (suppression permise au propriétaire : c'est la suppression de son compte)
    match /users/{uid}/state/backup {
      allow read, delete: if isOwner(uid);
      allow create, update: if false;
    }

    // Page ou transcription : identifiant cohérent avec le chemin, contenu en JSON texte ; une page trop lourde
    // pour un document laisse `json` vide et range son contenu en `parts` morceaux (sous-collection parts/)
    function validSyncDoc(idField, id) {
      let d = request.resource.data;
      return validId(id)
        && d.keys().hasOnly([idField, 'notebookId', 'updatedAt', 'deletedAt', 'json', 'parts'])
        && d.keys().hasAll([idField, 'notebookId', 'updatedAt', 'json'])
        && d[idField] == id
        && d.notebookId is string && d.notebookId.size() <= 128
        && d.json is string
        && d.updatedAt is number
        && nullOrNumber(d.get('deletedAt', null))
        && (d.get('parts', 0) is int) && d.get('parts', 0) >= 0 && d.get('parts', 0) <= 40;
    }

    match /users/{uid}/pages/{pageId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSyncDoc('id', pageId);

      match /parts/{n} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && n.matches('^[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string;
      }
    }

    match /users/{uid}/transcripts/{pageId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSyncDoc('pageId', pageId) && !('parts' in request.resource.data);
    }

    // Fichier de fond (PDF de cours, photo) : sa description ; ses octets sont dans chunks/ (900 Ko chacun,
    // 50 Mo au plus par fichier, empreinte SHA-256 vérifiée par l'appli à la réception)
    match /users/{uid}/files/{fileId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validId(fileId)
        && request.resource.data.keys().hasOnly(['id', 'name', 'type', 'size', 'chunks', 'sha256', 'updatedAt', 'deletedAt'])
        && request.resource.data.id == fileId
        && request.resource.data.name is string && request.resource.data.name.size() <= 300
        && request.resource.data.type is string && request.resource.data.type.size() <= 100
        && request.resource.data.size is int && request.resource.data.size >= 0 && request.resource.data.size <= 52428800
        && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 60
        && request.resource.data.sha256 is string && request.resource.data.sha256.matches('^[0-9a-f]{64}$')
        && request.resource.data.updatedAt is number
        && nullOrNumber(request.resource.data.get('deletedAt', null));

      match /chunks/{n} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && n.matches('^[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 1000000;
      }
    }

    // ---------------------------------------------------------------- partage en lecture seule

    function validShare() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'owner', 'notebookId', 'title', 'pageIds', 'sizes', 'versions', 'bgKeys', 'createdAt', 'updatedAt'])
        && d.v == 1
        && d.owner == request.auth.uid
        && d.notebookId is string && d.notebookId.size() <= 128
        && d.title is string && d.title.size() <= 500
        && d.pageIds is list && d.pageIds.size() <= 5000
        && d.sizes is map && d.versions is map && d.bgKeys is map
        && d.createdAt is number
        && d.updatedAt is number;
    }

    match /shares/{shareId} {
      allow get: if validId(shareId);
      // Lister : seulement SES partages (requête filtrée sur owner), pour les supprimer avec le compte
      allow list: if verified() && resource.data.owner == request.auth.uid;
      allow create: if verified() && validId(shareId) && validShare();
      // L'auteur reste l'auteur, la date de création ne bouge plus
      allow update: if verified() && resource.data.owner == request.auth.uid && validShare()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if verified() && resource.data.owner == request.auth.uid;

      function ownsShare() {
        return verified()
          && get(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid;
      }

      // Une page : son JSON et sa version
      match /pages/{pageId} {
        allow get: if true;
        allow list: if false;
        allow create, update: if ownsShare()
          && validId(pageId)
          && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
          && request.resource.data.json is string
          && request.resource.data.updatedAt is number;
        allow delete: if ownsShare();
      }

      // Le fond d'une page (PDF ou photo rendu en JPEG)
      match /bgs/{pageId} {
        allow get: if true;
        allow list: if false;
        allow create, update: if ownsShare()
          && validId(pageId)
          && request.resource.data.keys().hasOnly(['data', 'key'])
          && request.resource.data.data is string
          && request.resource.data.key is string && request.resource.data.key.size() <= 300;
        allow delete: if ownsShare();
      }
    }

    // backupConfig/… (autorisation Google Drive de la sauvegarde) : réservé au serveur, jamais lisible par
    // l'appli ni par personne d'autre ; il tombe dans la règle ci-dessous.

    // ---------------------------------------------------------------- tout le reste : fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
